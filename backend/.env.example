# ==============================================================================
# Server Configuration
# ==============================================================================
PORT=5000
NODE_ENV=development

# ==============================================================================
# Database Configuration
# ==============================================================================
# MongoDB connection URI (e.g., local MongoDB or MongoDB Atlas cluster connection string)
MONGO_URI=mongodb://localhost:27017/job_assistant

# ==============================================================================
# Security & Token Encryption (AES-256-GCM)
# ==============================================================================
# Key ring for token encryption/decryption supporting key rotation.
# Must be a valid JSON object mapping key IDs to 64-character hex strings (32 bytes).
# Generate a key using: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_KEYS={"v1":"<64_hex_chars_32_bytes>"}

# The active key ID to use for encrypting new payloads
CURRENT_KEY_ID=v1

# ==============================================================================
# Firebase Admin SDK Authentication
# ==============================================================================
# Stringified JSON service account credentials for Firebase Admin authentication verification
FIREBASE_SERVICE_ACCOUNT_JSON={}

# ==============================================================================
# Google OAuth 2.0 (Gmail Dispatch)
# ==============================================================================
# Google Cloud Console OAuth 2.0 Client credentials for Gmail sending integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================================
# OpenAI Configuration
# ==============================================================================
# API key for OpenAI LLM services (Resume parsing, ATS tailoring, analysis)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
