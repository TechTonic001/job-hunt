# ==============================================================================
# Job Assistant Backend - Environment Variables Template (.env.example)
# ==============================================================================
# NOTE: Copy this file to '.env' and fill in the placeholders with real credentials.
# NEVER commit the actual '.env' or any secret keys to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Port on which the Express server listens (default: 5000)
PORT=5000

# Runtime environment ('development', 'production', or 'test')
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# MongoDB connection URI (use 127.0.0.1 to avoid Node IPv6 localhost resolution delays)
MONGO_URI=mongodb://127.0.0.1:27017/job_assistant

# ------------------------------------------------------------------------------
# 3. Security & AES-256-GCM Token Encryption (Key Rotation Support)
# ------------------------------------------------------------------------------
# Active key ID to use when encrypting newly dispatched credentials and tokens
CURRENT_KEY_ID=v1

# JSON string mapping key IDs to 32-byte (64 hex characters) encryption secrets.
# Generate a cryptographically secure 256-bit key by running in your terminal:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEYS={"v1":"<GENERATE VIA: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\">"}

# ------------------------------------------------------------------------------
# 4. Firebase Admin SDK Authentication
# ------------------------------------------------------------------------------
# Go to Firebase Console -> Project Settings -> Service accounts -> "Generate new private key".
# Minify the downloaded JSON file into a single line without linebreaks.
FIREBASE_SERVICE_ACCOUNT_JSON=<MINIFIED_SINGLE_LINE_JSON_FROM_FIREBASE_CONSOLE>

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0 (Gmail Dispatcher)
# ------------------------------------------------------------------------------
# Go to Google Cloud Console (https://console.cloud.google.com/) -> APIs & Services -> Credentials.
# Create or select OAuth 2.0 Client IDs for a Web Application with Gmail API enabled.
GOOGLE_CLIENT_ID=<FROM_GOOGLE_CLOUD_CONSOLE_WEB_APP>
GOOGLE_CLIENT_SECRET=<FROM_GOOGLE_CLOUD_CONSOLE_WEB_APP>

# ------------------------------------------------------------------------------
# 6. OpenAI API Configuration (Semantic Matcher & Cover Letter Generator)
# ------------------------------------------------------------------------------
# Obtain from OpenAI Platform (https://platform.openai.com/api-keys).
OPENAI_API_KEY=<sk-YOUR_OPENAI_KEY>

# Default model used for ATS evaluations and semantic analysis (e.g., gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
